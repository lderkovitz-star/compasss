# All of these are set in Vercel: Project Settings -> Environment Variables.
# Copy this file to .env only if you want to run the app locally.

# Hosted Postgres connection string. Added automatically when you connect a
# Postgres database to the project from the Vercel Storage tab.
# Must NOT be localhost - Vercel cannot reach your machine.
DATABASE_URL=

# Vercel Blob token for resume, logo and backdrop uploads. Added automatically
# when you connect a Blob store to the project from the Vercel Storage tab.
BLOB_READ_WRITE_TOKEN=

# Session signing secret. Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# The platform owner's admin login. The first time you sign in at /admin-login
# with these, the account is created as a Super Admin automatically.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Preview deployments only. Previews share Production's DATABASE_URL unless you
# give them their own, so the build will not migrate or seed from a preview
# until this is set - and it has to name the database it is allowed to touch:
# a distinctive part of the preview branch's host, e.g. ep-quiet-moon-12345.
# If DATABASE_URL is still pointing at production, the value will not match and
# the build stops. See "Giving previews their own database" in DEPLOY.md.
# ALLOW_PREVIEW_DB_WRITES=
