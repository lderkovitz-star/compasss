# All of these are set in Vercel: Project Settings -> Environment Variables.
# Copy this file to .env only if you want to run the app locally.

# Hosted Postgres connection string. Added automatically when you connect a
# Postgres database to the project from the Vercel Storage tab.
# Must NOT be localhost - Vercel cannot reach your machine.
DATABASE_URL=

# Vercel Blob token for resume, logo and backdrop uploads. Added automatically
# when you connect a Blob store to the project from the Vercel Storage tab.
BLOB_READ_WRITE_TOKEN=

# Session signing secret. Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# The platform owner's admin login. The first time you sign in at /admin-login
# with these, the account is created as a Super Admin automatically.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Optional. A shared key that unlocks the console from the "Client Access" link
# in the site footer, so a field rep can get in on a phone without a password.
# At least 24 characters or it is ignored. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
#
# Read this before turning it on: one key cannot say who used it. Every
# sign-in is logged and the account list still enforces roles, but the audit
# row names the account below, not the person holding the key - and revoking
# it revokes it for everybody. Use named admin accounts for anything you need
# to attribute, and rotate this whenever someone leaves.
# MASTER_ADMIN_KEY=

# Which admin account a key sign-in becomes. Defaults to ADMIN_EMAIL. The
# account must exist and be active, or key sign-in stays off.
# MASTER_ADMIN_EMAIL=

# Preview deployments only. Previews share Production's DATABASE_URL unless you
# give them their own, so the build will not migrate or seed from a preview
# until this is set - and it has to name the database it is allowed to touch:
# a distinctive part of the preview branch's host, e.g. ep-quiet-moon-12345.
# If DATABASE_URL is still pointing at production, the value will not match and
# the build stops. See "Giving previews their own database" in DEPLOY.md.
# ALLOW_PREVIEW_DB_WRITES=

# Set by Vercel when you connect a Blob store - but often to Production only.
# BLOB_READ_WRITE_TOKEN is set per environment, and without it on Preview every
# résumé upload fails with "No read-write token found" while everything else
# works, which reads as broken code rather than a missing variable.
